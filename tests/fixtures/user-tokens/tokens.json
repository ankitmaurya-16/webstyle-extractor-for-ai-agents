{
  "$description": "A synthetic design-token file in the DTCG format, written for the mapping tests.",
  "color": {
    "$type": "color",
    "blue": {
      "500": { "$value": "#3b82f6" },
      "600": { "$value": "#2563eb" }
    },
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.067, 0.094, 0.153], "hex": "#111827" }
    },
    "paper": { "$value": "#ffffff" }
  },
  "semantic": {
    "$type": "color",
    "primary": { "$value": "{color.blue.600}" },
    "action": { "$value": "{semantic.primary}" },
    "loop-a": { "$value": "{semantic.loop-b}" },
    "loop-b": { "$value": "{semantic.loop-a}" },
    "missing": { "$value": "{color.red.500}" }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 1, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "default": { "$value": "6px" }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": ["Helvetica Neue", "Arial", "sans-serif"] }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "#0000000d",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } }
  }
}
